# ============================================================
# Unity 工程 Git 属性配置
# 文本文件自动规范化行尾
* text=auto
# ---- Unity YAML 文件（必须用 Unity 的 YAML 合并驱动，否则合并冲突会损坏文件） ----
*.unity merge=unityyamlmerge eol=lf
*.prefab merge=unityyamlmerge eol=lf
*.asset merge=unityyamlmerge eol=lf
*.anim merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf
*.mat merge=unityyamlmerge eol=lf
*.mask merge=unityyamlmerge eol=lf
*.overrideController merge=unityyamlmerge eol=lf
*.physicMaterial2D merge=unityyamlmerge eol=lf
*.physicsMaterial2D merge=unityyamlmerge eol=lf
*.playableAsset merge=unityyamlmerge eol=lf
*.spriteatlas merge=unityyamlmerge eol=lf
*.terrainlayer merge=unityyamlmerge eol=lf
*.shadergraph merge=unityyamlmerge eol=lf
*.shadersubgraph merge=unityyamlmerge eol=lf
# ---- 二进制文件（不参与 diff/merge，避免 Git 尝试文本合并导致损坏） ----
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif binary
*.bmp binary
*.tga filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.tif binary
*.psd filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.dds binary
*.ktx binary
# ---- 音频文件 ----
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.aiff binary
*.aif binary
*.mod binary
*.it binary
*.s3m binary
*.xm binary
# ---- 视频文件 ----
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.avi binary
*.webm binary
# ---- 字体文件 ----
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.woff binary
*.woff2 binary
# ---- 压缩包 / 大文件 ----
*.zip binary
*.7z binary
*.rar binary
*.gz binary
*.tgz binary
*.tar binary
*.unitypackage filter=lfs diff=lfs merge=lfs -text
# ---- 编译产物 ----
*.dll filter=lfs diff=lfs merge=lfs -text
*.pdb binary
*.mdb binary
*.apk binary
*.aab binary
*.app binary
*.exe binary
*.png !text !filter !merge !diff
*.jpg !text !filter !merge !diff
*.jpeg !text !filter !merge !diff
*.tga !text !filter !merge !diff
*.tiff !text !filter !merge !diff
*.psd !text !filter !merge !diff
*.exr !text !filter !merge !diff
*.hdr !text !filter !merge !diff
*.mp3 !text !filter !merge !diff
*.ogg !text !filter !merge !diff
*.wav !text !filter !merge !diff
*.mp4 !text !filter !merge !diff
*.mov !text !filter !merge !diff
*.ttf !text !filter !merge !diff
*.otf !text !filter !merge !diff
*.unitypackage !text !filter !merge !diff
*.dll !text !filter !merge !diff
